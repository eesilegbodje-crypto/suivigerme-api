# Base de données (Neon Postgres) — deux URLs distinctes comme pour CollectivIA :
# DATABASE_URL = connexion normale (via le pooler), DIRECT_URL = connexion directe (pour les migrations)
DATABASE_URL=
DIRECT_URL=

# Clé secrète utilisée pour signer les sessions de connexion (JWT). Choisis une longue chaîne
# aléatoire, différente de celle de CollectivIA.
JWT_SECRET=

# Adresses autorisées à appeler cette API (le site web SuiviGERME). Plusieurs adresses séparées
# par des virgules. En local, la valeur par défaut convient déjà.
ORIGINES_AUTORISEES=http://localhost:5173,http://localhost:5174

# Compte du premier coordonnateur, créé automatiquement au premier lancement de la base
# (voir prisma/seed.js). Choisis toi-même l'email et un mot de passe solide.
COORDINATEUR_INITIAL_NOM=
COORDINATEUR_INITIAL_EMAIL=
COORDINATEUR_INITIAL_MOT_DE_PASSE=

PORT=4100
