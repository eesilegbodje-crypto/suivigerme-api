// Schéma de base de données de SuiviGERME.
// Point de départ (étape 1 du projet) : les participants suivis et les sessions de formation
// GERME auxquelles ils prennent part. Les outils GERME (calcul de coût, plan d'affaires...) et
// le questionnaire d'évaluation seront ajoutés dans les étapes suivantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Un compte permettant de se connecter à la plateforme (coordonnateur ou conseiller).
model User {
  id         String   @id @default(cuid())
  nom        String
  email      String   @unique
  motDePasse String
  role       String   @default("coordonnateur") // "coordonnateur" | "conseiller"
  creeLe     DateTime @default(now())

  // Vrai juste apres la creation du compte par le coordonnateur (mot de passe provisoire choisi
  // par lui) ou apres une reinitialisation pour mot de passe oublie : oblige la personne a en
  // definir un nouveau des sa prochaine connexion, avant de pouvoir utiliser le reste de l'appli.
  doitChangerMotDePasse Boolean @default(false)

  // Un compte suspendu par le coordonnateur ne peut plus se connecter (nouvelle tentative
  // refusee), et si une session etait deja ouverte au moment de la suspension, elle est coupee
  // immediatement (verifie a chaque requete authentifiee, pas seulement a la connexion).
  // Ses donnees (PME, formations...) restent intactes et redeviennent accessibles des la
  // reactivation par le coordonnateur.
  suspendu Boolean @default(false)

  // Chaque compte est totalement independant : il ne voit et ne modifie que les PME et
  // formations qu'il a lui-meme creees (aucun partage entre consultants, meme le coordonnateur).
  participants Participant[]
  formations   Formation[]
}

// Journal des evenements de securite (connexions, actions sensibles sur les comptes) — visible
// uniquement par le coordonnateur, dans le module Securite. Ecrit au fil de l'eau a partir de
// maintenant (aucun historique avant la creation de ce modele). Email/nom sont dupliques ici
// plutot que lies par relation, pour que l'historique reste lisible meme si le compte concerne
// est supprime plus tard.
model JournalSecurite {
  id            String   @id @default(cuid())
  type          String   // voir la liste des types dans src/lib/journalSecurite.js
  emailConcerne String
  nomConcerne   String?
  // Qui a realise l'action (un coordonnateur) ; absent si l'evenement vient du compte concerne
  // lui-meme (connexion, changement volontaire de mot de passe...).
  acteurNom     String?
  details       String?
  dateEvenement DateTime @default(now())

  @@index([type])
  @@index([dateEvenement])
  @@index([emailConcerne])
}

// Une personne (entrepreneur ou responsable de PME) suivie par le programme.
model Participant {
  id              String   @id @default(cuid())
  nom             String
  telephone       String?
  email           String?
  localite        String?
  nomEntreprise   String?
  secteurActivite String?
  statut          String   @default("Actif") // "Actif" | "Sorti" | "Abandon"
  // Determine quel module de suivi s'applique a cette PME : quel questionnaire ABF utiliser, et
  // acces aux onglets specifiques (Fiche technique pour l'agriculture, Prophylaxie pour l'elevage).
  // Distinct de "secteurActivite" ci-dessus (texte libre decrivant l'activite) : "typeSuivi" est
  // une des 3 valeurs fixes qui pilote le comportement de l'appli. "Generique" = comportement
  // historique, inchange. Les participants crees avant ce champ restent "Generique" par defaut,
  // aucune migration de donnees necessaire.
  typeSuivi       String   @default("Generique") // "Generique" | "Agriculture" | "Elevage"
  // Filieres precises au sein du type de suivi (ex. ["mais", "tomate"]), utilisees pour choisir
  // les fiches technique/prophylaxie a afficher. Un participant peut cumuler plusieurs activites
  // (ex. un agriculteur qui fait a la fois mais ET tomate) -- liste (pas une valeur unique), vide
  // pour le type "Generique". Remplace l'ancien champ "filiere" (String? unique).
  filieres        String[] @default([])
  // Renseigne uniquement quand filieres contient "autre" (activite(s) non listee(s), Agriculture
  // ou Elevage) : precision en texte libre saisie par le conseiller, une ou plusieurs activites
  // separees par une virgule (ex. "Cacao, Café"). Ignoree/remise a null si "autre" n'est pas
  // selectionne.
  filierePrecision String?
  // Fiches technique/prophylaxie generees automatiquement par IA pour les activites qui n'ont pas
  // de fiche standard (typiquement celles listees via "autre") : un objet {cle: fiche}, une entree
  // par activite generee, mis en cache ici pour ne regenerer qu'a la demande ("Regenerer") plutot
  // qu'a chaque ouverture de l'onglet. Sans objet (toujours null) si aucune activite de ce
  // participant n'a eu besoin de generation IA, ou pour le type "Generique".
  ficheReferenceIa       Json?
  ficheReferenceGenereeLe DateTime?
  notes           String?
  // Le consultant (compte) qui a enregistre cette PME. Optionnel dans le schema uniquement pour
  // permettre le rattachement des PME creees avant l'existence de ce champ (voir migration) ;
  // en pratique, toujours renseigne des la creation.
  creeParId       String?
  creePar         User?    @relation(fields: [creeParId], references: [id])
  // Diagnostic IA transversal de la PME (ABF + finances + accompagnement, pas seulement l'ABF).
  // Jamais recalcule automatiquement : uniquement quand le consultant clique sur "Regenerer".
  diagnosticGlobalIa       Json?
  diagnosticGlobalGenereLe DateTime?
  creeLe          DateTime @default(now())
  majLe           DateTime @updatedAt

  participations ParticipationFormation[]
  evaluationsAbf EvaluationABF[]
  notesSuivi     NoteSuivi[]
  relevesMensuels  ReleveMensuel[]
  estimationsCouts EstimationCout[]
  actionsAccompagnement ActionAccompagnement[]

  @@index([statut])
  @@index([creeParId])
}

// Une session de formation GERME donnée à un groupe de participants.
model Formation {
  id        String   @id @default(cuid())
  module    String   // voir la liste des modules dans src/lib/modulesGerme.js
  date      DateTime
  lieu      String?
  formateur String?
  notes     String?
  // Le consultant (compte) qui a organise cette session (voir note equivalente sur Participant).
  creeParId String?
  creePar   User?    @relation(fields: [creeParId], references: [id])
  creeLe    DateTime @default(now())

  participations ParticipationFormation[]

  @@index([module])
  @@index([date])
  @@index([creeParId])
}

// Table de liaison : qui a participé à quelle formation, et comment ça s'est passé pour lui.
model ParticipationFormation {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  formationId   String
  formation     Formation   @relation(fields: [formationId], references: [id], onDelete: Cascade)
  present       Boolean  @default(true)
  appreciation  String?  // note libre sur l'assiduité ou la progression de ce participant
  creeLe        DateTime @default(now())

  @@unique([participantId, formationId])
}


// Une évaluation ABF (Analyse des Besoins en Formation) remplie par un participant, avant ou
// après une formation, pour identifier ses besoins puis mesurer son évolution. La structure
// complète des questions et des réponses possibles est définie dans src/lib/questionnaireAbf.js
// (pas dans la base de données), pour rester facile à faire évoluer.
model EvaluationABF {
  id              String   @id @default(cuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  moment          String   // "Avant formation" | "Après formation"
  dateEvaluation  DateTime
  reponses        Json     // { [idQuestion]: indexOptionChoisie (0 à 3) }
  besoinsDomaines String[] @default([])
  besoinsAutre    String?
  diagnosticIa       Json?     // dernier diagnostic généré par l'IA (voir src/lib/aiService.js)
  diagnosticGenereLe DateTime? // quand ce diagnostic a été généré (null = jamais)
  creeLe          DateTime @default(now())

  actionsAccompagnement ActionAccompagnement[]

  @@index([participantId])
}

// Une note libre et datée pour suivre, sur le terrain, la progression d'un participant entre deux
// évaluations ABF (par ex. ce qui est observé lors d'une visite de suivi).
model NoteSuivi {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  dateNote      DateTime
  contenu       String
  creeLe        DateTime @default(now())

  @@index([participantId])
}


// Un relevé mensuel simplifié de l'activité d'un participant (Tenue des registres) : les chiffres
// du mois + un état des lieux de la rigueur avec laquelle il tient ses registres. Le bénéfice net
// n'est PAS stocké : il est recalculé à chaque lecture (voir src/lib/calculsFinanciers.js).
model ReleveMensuel {
  id              String   @id @default(cuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  mois            DateTime // toujours le 1er jour du mois concerné
  ventesTotales   Float
  achatsTotaux    Float
  depenses        Float
  registreVentes    Boolean @default(false)
  registreAchats    Boolean @default(false)
  registreCaisse    Boolean @default(false)
  registreCreances  Boolean @default(false)
  registreActifs    Boolean @default(false)
  notes           String?
  creeLe          DateTime @default(now())

  @@unique([participantId, mois])
  @@index([participantId])
}

// Une fiche de calcul du prix de revient pour un produit ou service d'un participant (Estimation
// des coûts). Coût total, coût unitaire et prix de vente conseillé sont recalculés à chaque
// lecture, jamais stockés (voir src/lib/calculsFinanciers.js).
model EstimationCout {
  id                String   @id @default(cuid())
  participantId     String
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  nomProduit        String
  dateEstimation    DateTime
  coutMatieres      Float
  coutMainOeuvre    Float
  fraisGeneraux     Float
  quantiteProduite  Float
  margeSouhaitee    Float @default(30)
  notes             String?
  creeLe            DateTime @default(now())

  @@index([participantId])
}

// Une action du plan d'accompagnement : pour un probleme identifie chez le participant (souvent
// via l'ABF), l'action a mener, qui en est responsable, pour quand, et son statut d'avancement.
// La note de verification permet de documenter en texte que l'action a bien ete realisee (les
// pieces jointes photo/document pourront etre ajoutees dans une version ulterieure).
model ActionAccompagnement {
  id               String   @id @default(cuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  probleme         String
  action           String
  // Une formation GERME a suivre en complement de l'action ci-dessus : un meme probleme peut
  // appeler a la fois une action concrete ET une formation, les deux ne s'excluent pas. Optionnel ;
  // identifiant de module parmi ceux de src/lib/modulesGerme.js.
  formationLiee    String?
  responsable      String
  echeance         DateTime
  statut           String   @default("À faire") // "À faire" | "En cours" | "Réalisée" | "Partiellement réalisée" | "Abandonnée"
  noteVerification String?
  // D'où vient ce problème : diagnostic IA d'une évaluation ABF, ou observation directe du
  // consultant sur le terrain (sans lien avec l'ABF). evaluationAbfId est optionnel et repassé à
  // null si l'évaluation source est supprimée plus tard (l'action elle-même n'est jamais perdue).
  origine          String   @default("Observation") // "ABF" | "IA_globale" | "Observation"
  evaluationAbfId  String?
  evaluationAbf    EvaluationABF? @relation(fields: [evaluationAbfId], references: [id], onDelete: SetNull)
  creeLe           DateTime @default(now())
  majLe            DateTime @updatedAt

  @@index([participantId])
  @@index([evaluationAbfId])
}
